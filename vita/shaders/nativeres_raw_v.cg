// NativeRes: vertex program for 3D draws whose vertices the GPU reads in the
// PSP's own layout ("raw vertices", NATIVEPSP_DRAW_RAW_VERTICES). The
// attribute formats do the reading: they are
// chosen per PSP vertex format when the program is patched (one patched
// program per format, nativepsp_render.c RawProgramFor). This program does
// what the capture's CPU path does with such a vertex (raw_vertex.rs is the
// CPU's copy of it: keep both in step), with the outputs of
// nativeres_textured_v.cg (the same fragment programs).
//
// aPosition: the raw position (s8, s16 or float, as numbers): uRows hold
//   the position scale (and the bone x weight of single-weight runs).
// aTexcoord: the raw texture coordinates (u8, u16 or float, as numbers);
//   uRawUv: scale u, v, offset u, v (the format's scale folded in; scale 0
//   for formats without texture coordinates).
// aColorBytes: the two bytes of a 16-bit colour (5650, 5551, 4444), 0..255
//   each: reading the 16-bit field as one number came out wrong on the GPU
//   (measured on the Vita, 2026-11-08), bytes come out right.
// aColor32: an 8888 colour, 0..1 per channel.
// uFormat: y = the colour format (VERTEX_TYPE bits 2..4): 0 none, 4 5650,
//   5 5551, 6 4444, 7 8888.
// aNormal: the raw normal (s8, s16 or float, as numbers; (byte 0..2) for
//   formats without one, unused then): only for lighting 3.
// aWeights0, aWeights1: the raw skinning weights 1-4 and 5-8 (u8, u16 or
//   float; read from byte 0 for formats with fewer, unused then: their bones
//   are zero). uSkin: x > 0.5 = skinned here (frame.rs Draw::bones), y = what
//   the raw weights are multiplied by (1/128, 1/32768, 1). uBones: 8 bones
//   of 3 rows (float4: the bone's coordinate from raw x, y, z, 1), zeros
//   beyond the format's weights. Skinned position = sum of weight x bone
//   applied to (raw x, y, z, 1), as Transform::skin_raw (raw_vertex.rs skin);
//   normals with the bones' 3x3 parts.
// uMaterial, uAmbient, uEmissive, uColors: frame.rs GpuTransform raw_*:
//   colours as whole numbers 0..255; uColors = (lighting, opaque, replace,
//   doubled alpha: blend factor "doubled source alpha", the vertex alpha
//   doubled instead, at most 255, after opaque and before replace).
// uScale: blend factor FIX A (frame.rs RawColors::scale): w > 0.5: last of
//   all, RGB = floor(RGB x uScale.rgb / 255) (blend.rs scale_color).
//   Lighting 3 (raw_vertex.rs lighting::LIGHTS): the vertex colour (white
//   without one) lit with directional lights by uNormalRows (normal to world
//   space, GpuTransform::normal_rows) and uLights (the light set, 22 float4),
//   as nativeres_3d_v.cg lights its GPU-lit vertices (GpuLights::color).
// uRows, uFogRow, uViewport, wvp, uUvScale: as nativeres_3d_v.cg.
//
// Depth and the near plane: the GPU clips -w <= z <= w (measured). The PSP
// clips at its near plane z = -w and keeps everything beyond its far plane,
// so z goes out as (z - w) / 2: the GPU's near plane is the PSP's and its far
// plane is at z = 3w, out of reach. The viewport's z (set per transform by
// the display, sceGxmSetViewport) turns that into the depth the other draws
// write for the same PSP depth. No division by w here: a vertex behind the
// camera stays finite until the GPU clips its triangle.
//
// Compiled on the Vita with the shader compiler app (README.md "Shaders").
//
// RAW_PLAIN (nativeres_raw_plain_v.cg, generated from this file by
// scripts/shader-variants.sh: keep them in step): the same without skinning
// and directional lights (no aNormal, aWeights0/1, uNormalRows, uLights,
// uSkin, uBones), for draws that need neither (nearly all but the riders).
// The full program costs every vertex its skinning and lighting code even
// when the uniforms switch them off (2026-11-10: GPU time measured).

// The number above the low bits of a whole number v (1 / 2^low = inverse):
// v >> low. Only multiplications by exact powers of two, and half a step of
// room for floor().
float High(float value, float inverse)
{
	return floor(value * inverse + inverse * 0.5f);
}

// The GE's pow for lighting, as nativeres_3d_v.cg.
float PspPow(float x, float e)
{
	if (e <= 0.0f)
		return 1.0f;
	return x > 0.0f ? exp2(e * log2(x)) : 0.0f;
}

// One bone's part of a skinned position and normal: weight x bone.
void AddBone(inout float3 position, inout float3 normal, float weight, float4 r0, float4 r1, float4 r2, float4 p, float3 n)
{
	position += weight * float3(dot(r0, p), dot(r1, p), dot(r2, p));
	normal += weight * float3(dot(r0.xyz, n), dot(r1.xyz, n), dot(r2.xyz, n));
}

// A 5- or 6-bit channel widened to 8 bits as color.rs `expand`.
float Expand5(float c) { return c * 8.0f + High(c, 0.25f); }
float Expand6(float c) { return c * 4.0f + High(c, 0.0625f); }

// The vertex colour as whole numbers 0..255 (R, G, B, A), as the CPU's
// decoders widen it.
float4 VertexColor(float mode, float2 bytes, float4 color32, float4 material)
{
	float lo = bytes.x, hi = bytes.y;
	if (mode > 6.5f)
		return floor(color32 * 255.0f + 0.5f);
	if (mode > 5.5f) {  // 4444: R G | B A nibbles, each times 17
		float g = High(lo, 1.0f / 16.0f), a = High(hi, 1.0f / 16.0f);
		return float4(lo - g * 16.0f, g, hi - a * 16.0f, a) * 17.0f;
	}
	if (mode > 4.5f) {  // 5551: R 5 | G 3+2 | B 5 | A 1
		float g = High(lo, 1.0f / 32.0f), a = High(hi, 1.0f / 128.0f), b = High(hi, 1.0f / 4.0f) - a * 32.0f;
		float g2 = hi - High(hi, 1.0f / 4.0f) * 4.0f;
		return float4(Expand5(lo - g * 32.0f), Expand5(g + g2 * 8.0f), Expand5(b), a * 255.0f);
	}
	if (mode > 3.5f) {  // 5650: R 5 | G 3+3 | B 5
		float g = High(lo, 1.0f / 32.0f), b = High(hi, 1.0f / 8.0f);
		float g2 = hi - b * 8.0f;
		return float4(Expand5(lo - g * 32.0f), Expand6(g + g2 * 8.0f), Expand5(b), 255.0f);
	}
	return material;
}

void main(
	float3 aPosition,
	float2 aTexcoord,
	float2 aColorBytes,
	float4 aColor32,
#ifndef RAW_PLAIN
	float3 aNormal,
	float4 aWeights0,
	float4 aWeights1,
#endif
	uniform float4x4 wvp,
	uniform float4 uRows[4],
	uniform float4 uFogRow,
	uniform float4 uViewport,
	uniform float2 uUvScale,
	uniform float4 uFormat,
	uniform float4 uRawUv,
	uniform float4 uMaterial,
	uniform float4 uAmbient,
	uniform float4 uEmissive,
	uniform float4 uColors,
	uniform float4 uScale,
#ifndef RAW_PLAIN
	uniform float4 uNormalRows[3],
	uniform float4 uLights[22],
	uniform float4 uSkin,
	uniform float4 uBones[24],
#endif
	out float4 vPosition : POSITION,
	out float2 vTexcoord : TEXCOORD0,
	out float4 vColor : TEXCOORD1,
	out float vFog : TEXCOORD2,
	out float3 vSpecular : TEXCOORD3)
{
	// The separate specular colour (LIGHTMODE 1), added after texturing by
	// the fragment program; 0 unless lit with it.
	vSpecular = float3(0.0f, 0.0f, 0.0f);
	float3 position = aPosition;
#ifndef RAW_PLAIN
	float3 normal = aNormal;
	if (uSkin.x > 0.5f) {
		float4 raw = float4(aPosition, 1.0f);
		float4 w0 = aWeights0 * uSkin.y, w1 = aWeights1 * uSkin.y;
		position = float3(0.0f, 0.0f, 0.0f);
		normal = float3(0.0f, 0.0f, 0.0f);
		AddBone(position, normal, w0.x, uBones[0], uBones[1], uBones[2], raw, aNormal);
		AddBone(position, normal, w0.y, uBones[3], uBones[4], uBones[5], raw, aNormal);
		AddBone(position, normal, w0.z, uBones[6], uBones[7], uBones[8], raw, aNormal);
		AddBone(position, normal, w0.w, uBones[9], uBones[10], uBones[11], raw, aNormal);
		AddBone(position, normal, w1.x, uBones[12], uBones[13], uBones[14], raw, aNormal);
		AddBone(position, normal, w1.y, uBones[15], uBones[16], uBones[17], raw, aNormal);
		AddBone(position, normal, w1.z, uBones[18], uBones[19], uBones[20], raw, aNormal);
		AddBone(position, normal, w1.w, uBones[21], uBones[22], uBones[23], raw, aNormal);
	}
#endif
	float4 p = float4(position, 1.0f);
	float4 clip = float4(dot(uRows[0], p), dot(uRows[1], p), dot(uRows[2], p), dot(uRows[3], p));
	// As nativeres_3d_v.cg's screen position times w (linear in clip space).
	float2 screenTimesW = uViewport.xy * clip.w + uViewport.zw * clip.xy;
	vPosition = mul(float4(screenTimesW, 0.0f, clip.w), wvp);
	vPosition.z = 0.5f * (clip.z - clip.w);
	vTexcoord = (aTexcoord * uRawUv.xy + uRawUv.zw) * uUvScale;
	vFog = dot(uFogRow, p);

	// The colour: raw_vertex.rs GpuTransform::raw_color.
	float mode = uFormat.y;
	float4 color = VertexColor(mode, aColorBytes, aColor32, uMaterial);
#ifndef RAW_PLAIN
	if (uColors.x > 2.5f) {
		// Lit with directional lights: nativeres_3d_v.cg's lighting.
		float4 base = color * (1.0f / 255.0f);
		float3 n = float3(dot(uNormalRows[0].xyz, normal), dot(uNormalRows[1].xyz, normal), dot(uNormalRows[2].xyz, normal));
		float length2 = dot(n, n);
		n = length2 > 0.0f ? n * rsqrt(length2) : float3(0.0f, 0.0f, 1.0f);
		float4 fromVertex = uLights[21];
		float4 ambientColor = lerp(uLights[18], base, fromVertex.x);
		float3 diffuseColor = lerp(uLights[19].rgb, base.rgb, fromVertex.y);
		float3 specularColor = lerp(uLights[20].rgb, base.rgb, fromVertex.z);
		float coefficient = uLights[17].a;
		float3 diffuse = float3(0.0f, 0.0f, 0.0f);
		float3 specular = float3(0.0f, 0.0f, 0.0f);
		for (int i = 0; i < 4; i++) {
			float lightDot = dot(uLights[i].xyz, n);
			if (uLights[8 + i].a > 0.5f)
				lightDot = PspPow(lightDot, coefficient);
			diffuse += uLights[8 + i].rgb * max(lightDot, 0.0f);
			if (uLights[12 + i].a > 0.5f && lightDot >= 0.0f)
				specular += uLights[12 + i].rgb * PspPow(dot(uLights[4 + i].xyz, n), coefficient);
		}
		float4 lit;
		float3 specularPart = specular * specularColor;
		if (uLights[20].a > 0.5f) {
			// Separate specular: after texturing (vSpecular).
			vSpecular = saturate(specularPart);
			specularPart = float3(0.0f, 0.0f, 0.0f);
		}
		lit.rgb = saturate(uLights[17].rgb + uLights[16].rgb * ambientColor.rgb + diffuse * diffuseColor + specularPart);
		lit.a = uLights[19].a > 0.5f ? 1.0f : saturate(uLights[16].a * ambientColor.a);
		if (uColors.y > 0.5f)
			lit.a = 1.0f;
		vColor = lit;
		return;
	}
#endif
	if (uColors.x > 0.5f) {
		// Lit without lights: ((2m + 1)(2a + 1)) >> 10 plus the emission.
		float4 material = (uColors.x < 1.5f && mode > 3.5f) ? color : uMaterial;
		float4 product = (2.0f * material + 1.0f) * (2.0f * uAmbient + 1.0f);
		color = min(float4(High(product.x, 1.0f / 1024.0f), High(product.y, 1.0f / 1024.0f),
		                   High(product.z, 1.0f / 1024.0f), High(product.w, 1.0f / 1024.0f)) + uEmissive, 255.0f);
	}
	if (uColors.y > 0.5f)
		color.a = 255.0f;
	if (uColors.w > 0.5f)
		color.a = min(2.0f * color.a, 255.0f);
	if (uColors.z > 1.5f)
		color = float4(255.0f, 255.0f, 255.0f, 255.0f);
	else if (uColors.z > 0.5f)
		color.rgb = float3(255.0f, 255.0f, 255.0f);
	if (uScale.w > 0.5f)
		color.rgb = floor((color.rgb * uScale.rgb + 0.5f) * (1.0f / 255.0f));
	vColor = color * (1.0f / 255.0f);
}
