// NativeRes: fragment program for textured PSP draws: texel times the
// interpolated vertex colour, times the colour scale (2 with the PSP's
// colour doubling, RGB only), clamped; then PSP fog (as in PPSSPP): the
// colour moves toward the fog colour as the fog factor goes from 1 to 0.
// Alpha is not fogged.
//
// uFogAndScale: rgb = fog colour (0..255), a = colour scale (1 or 2).
//
// Compiled on the Vita with the shader compiler app (README.md "Shaders").
//
// BLEND_FIX (nativeres_textured_fix_f.cg, generated by scripts/shader-variants.sh:
// keep them in step): the GE's fixed destination factor FIX B, grey, which
// GXM's blending can't take (no constant colour). The program writes FIX B
// as its alpha and applies the source factor itself; the blend is then
// source ONE, destination SOURCE ALPHA: src * factor + dst * FIX B, exact.
// uBlendFix: x = FIX B (0..1), y = the source factor applied here: 0 none
// (FIX A is already in the colour), 1 source alpha, 2 one minus source alpha.

// The GE's texture function (modulate) and fog in its integer arithmetic
// (ppsspp-ref GPU/Software/Sampler.cpp GetTextureFunctionOutput and
// DrawPixel.cpp's fog): texel and vertex colour truncated to 8 bits,
// (p + 1) t >> 8 (x 2 with colour doubling), the specular added, the fog
// factor f = floor(f x 256) and (c f + fog (255 - f) + 255) >> 8, here as
// f (c - fog) + 255 fog + 255: one multiply-add. Rounding in float instead
// left pictures about one level brighter than the PSP's (MHF). All values
// stay below 2^17, so fp32 is exact; the + 0.01 keeps a value that arrives
// as k / 255 (or k / 256) minus a rounding error at k. Without fog, f = 1
// gives f8 = 255, which leaves the colour as it is.
// fogAndScale: rgb the fog colour 0..255, a the colour scale (1 or 2).
// Returns the GE's whole values, 0..255 (alpha too: the alpha test and the
// frame-read blends take them as they are). tools/shadetest.py checks it on
// the Vita. NO_SPECULAR: the program is only used for draws without a
// separate specular colour (4 instructions less). FOG_UNFLOORED: the rgb
// comes back unfloored, for a caller that floors anyway (3 less).
//
// Cost (tools/gxpinfo.py, instructions per pixel): floor written as
// x - frac(x) compiles shorter than floor(x); the fog is the dearest part
// (~13 of a textured program's ~27); the specular 4. Keep this function the
// same in nativeres_textured_f.cg, nativeres_textured_test_f.cg and
// nativeres_textured_read_f.cg.
#define FLOOR(x) ((x) - frac(x))
float4 GeShade(float4 texel, float4 vertexColor, float3 specular, float fog, float4 fogAndScale)
{
	float4 t = FLOOR(texel * 255.0f + 0.01f);
	float4 p1 = FLOOR(vertexColor * 255.0f + 1.01f); // p + 1
	float4 c = FLOOR(p1 * t * (float4(fogAndScale.aaa, 1.0f) * (1.0f / 256.0f)));
#ifdef NO_SPECULAR
	c.rgb = min(c.rgb, 255.0f);
#else
	c.rgb = min(c.rgb + FLOOR(specular * 255.0f + 0.5f) * fogAndScale.aaa, 255.0f);
#endif
	float f = min(FLOOR(saturate(fog) * 256.0f + 0.01f), 255.0f);
#ifdef FOG_UNFLOORED
	// The caller floors it with its cut (floor(floor(x) / 8) = floor(x / 8)).
	c.rgb = (f * (c.rgb - fogAndScale.rgb) + (fogAndScale.rgb * 255.0f + 255.0f)) * (1.0f / 256.0f);
#else
	c.rgb = FLOOR((f * (c.rgb - fogAndScale.rgb) + (fogAndScale.rgb * 255.0f + 255.0f)) * (1.0f / 256.0f));
#endif
	return c;
}

float4 main(
	float2 vTexcoord : TEXCOORD0,
	float4 vColor : TEXCOORD1,
	float2 vFog : TEXCOORD2,
	float3 vSpecular : TEXCOORD3,
	uniform sampler2D tex,
#ifdef BLEND_FIX
	uniform float4 uBlendFix,
#endif
	uniform float4 uFogAndScale) : COLOR
{
	// Colour, specular and fog came times w (screen-linear, nativeres_3d_v.cg).
	float overW = 1.0f / vFog.y;
	// The separate specular colour after texturing, then the doubling (PPSSPP:
	// v = p * t + s, then the colour doubling, clamped), then fog.
	float4 color = GeShade(tex2D(tex, vTexcoord), vColor * overW, vSpecular * overW, vFog.x * overW, uFogAndScale) * (1.0f / 255.0f);
#ifdef BLEND_FIX
	float sourceAlpha = saturate(color.a);
	color.rgb *= uBlendFix.y > 1.5f ? 1.0f - sourceAlpha : (uBlendFix.y > 0.5f ? sourceAlpha : 1.0f);
	color.a = uBlendFix.x;
#endif
	return color;
}
