	float tested = (float)((unsigned char)c.a & (unsigned char)uAlphaTest.w);
	if ((tested - uAlphaTest.x) * (uAlphaTest.y - tested) * uAlphaTest.z < 0.0f)
		discard;
#else
	if ((c.a - uAlphaTest.x) * (uAlphaTest.y - c.a) * uAlphaTest.z < 0.0f)
		discard;
#endif
