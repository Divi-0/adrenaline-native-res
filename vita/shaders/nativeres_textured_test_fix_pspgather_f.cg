	float2 at = (m - fraction + 0.5f) * step;
	float2 next = at + step;
	float2 f = fraction * size.w; // 0 for the GE's nearest texel
	float4 a = tex2D<float4>(tex, at);
	float4 b = tex2D<float4>(tex, float2(next.x, at.y));
	float4 c = tex2D<float4>(tex, float2(at.x, next.y));
	float4 d = tex2D<float4>(tex, next);
	float4 top = FLOOR((a + (b - a) * f.x) * 255.0f + (1.0f / 32.0f));
	float4 bottom = FLOOR((c + (d - c) * f.x) * 255.0f + (1.0f / 32.0f));
