// GENERATED by scripts/shader-variants.sh from nativeres_textured_test_f.cg: do not edit.
#define BLEND_FIX 1
// NativeRes: nativeres_textured_f.cg with the PSP's alpha test, for textured
// draws that have it on (as PPSSPP's FragmentShaderGenerator.cpp does it:
// after fog, on the fragment's alpha rounded to 0..255, discard if it fails).
// Without the test, transparent texels of a draw with blending off would be
// drawn (and write depth) where the PSP throws them away.
//
// uAlphaTest: the alpha values (0..255) that pass are lo (x) .. hi (y); with
// z = 1 the ones outside pass instead (NOTEQUAL). The display works the range
// out from the compare function and reference (nativeres_render.c
// AlphaTestRange). A range instead of == / != compares: PPSSPP notes a
// PowerVR driver problem with an equality check plus discard.
//
// Compiled on the Vita with the shader compiler app (README.md "Shaders").
//
// BLEND_FIX (nativeres_textured_test_fix_f.cg, generated by scripts/shader-variants.sh:
// keep them in step): the GE's fixed destination factor FIX B, grey, which
// GXM's blending can't take (no constant colour). The program writes FIX B
// as its alpha and applies the source factor itself; the blend is then
// source ONE, destination SOURCE ALPHA: src * factor + dst * FIX B, exact.
// uBlendFix: x = FIX B (0..1), y = the source factor applied here: 0 none
// (FIX A is already in the colour), 1 source alpha, 2 one minus source alpha.

float4 main(
	float2 vTexcoord : TEXCOORD0,
	float4 vColor : TEXCOORD1,
	float vFog : TEXCOORD2,
	float3 vSpecular : TEXCOORD3,
	uniform sampler2D tex,
#ifdef BLEND_FIX
	uniform float4 uBlendFix,
#endif
	uniform float4 uFogAndScale,
	uniform float4 uAlphaTest) : COLOR
{
	float4 color = tex2D(tex, vTexcoord) * vColor;
	// The separate specular colour after texturing, then the doubling (PPSSPP:
	// v = p * t + s, then the colour doubling, clamped).
	color.rgb = saturate((color.rgb + vSpecular) * uFogAndScale.a);
	color.rgb = lerp(uFogAndScale.rgb, color.rgb, saturate(vFog));
	float alpha = floor(saturate(color.a) * 255.0 + 0.5);
	float inside = step(uAlphaTest.x - 0.5, alpha) * step(alpha, uAlphaTest.y + 0.5);
	if (abs(inside - uAlphaTest.z) < 0.5)
		discard;
#ifdef BLEND_FIX
	float sourceAlpha = saturate(color.a);
	color.rgb *= uBlendFix.y > 1.5f ? 1.0f - sourceAlpha : (uBlendFix.y > 0.5f ? sourceAlpha : 1.0f);
	color.a = uBlendFix.x;
#endif
	return color;
}
