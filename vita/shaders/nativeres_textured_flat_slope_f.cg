#ifdef SLOPE_LOD
// SLOPE_LOD (nativeres_textured[_fix|_test|_test_fix|_flat]_slope_f.cg, setting
// `slopemip`, core texture.rs slope_level): the draw's texture in the GE's
// "slope" level mode, the level from the pixel's 1/w (overW: linear on the
