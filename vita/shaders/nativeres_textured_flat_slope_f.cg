	// "seventy-third session"; nativeres_textured_f.cg OUT_BYTES): the product
	// / 256 half a level down, at least 1/512 from a tie, goes through the
	// conversion to bytes as its floor, saturated at 255 (the colour
	// doubling's clamp): no floor, no min, no c / 255 for GXM to convert.
	return (unsigned char4)(p1 * t * (float4(uFogAndScale.aaa, 1.0f) * (1.0f / 256.0f)) - (127.5f / 256.0f));
}
