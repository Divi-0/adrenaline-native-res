// The GE's texture function (modulate) and fog in its integer arithmetic
// (ppsspp-ref GPU/Software/Sampler.cpp GetTextureFunctionOutput and
// DrawPixel.cpp's fog): texel and vertex colour truncated to 8 bits,
// (p + 1) t >> 8 (x 2 with colour doubling), the specular added, the fog
// factor f = floor(f x 256) and (c f + fog (255 - f) + 255) >> 8, here as
// f (c - fog) + 255 fog + 255: one multiply-add. Rounding in float instead
// left pictures about one level brighter than the PSP's (MHF). All values
// stay below 2^17, so fp32 is exact. The texel is rounded: an 8-bit (or
// 4-bit) one arrives as about k / 255, and rounding gives k back even from
// a half-precision sample (within 0.062 levels of k), while truncating lost
// a level there; these programs get their samples, and the vertex colour,
// in fp32 anyway (the compiler gives them fp32 with or without fast
// precision, unlike nativeres_textured_f.cg: see its "shacc: precise").
// Native 5- and 6-bit textures are not the GE's bit expansion either way
// (4 of 32 values off rounded, 15 truncated). Without fog, f = 1
// gives f8 = 255, which leaves the colour as it is.
// fogAndScale: rgb the fog colour 0..255, a the colour scale (1 or 2).
// Returns the GE's whole values, 0..255 (alpha too: the alpha test and the
// frame-read blends take them as they are). tools/shadetest.py checks it on
// the Vita. NO_SPECULAR: the program is only used for draws without a
// separate specular colour (4 instructions less). FOG_UNFLOORED: the rgb
// comes back unfloored, for a caller that floors anyway (3 less). NO_FOG:
// only for draws without fog (the frame-read 565 ones, `ReadVariant::Fast`
// `fogless`): the fog part left out, exact (~14 instructions less).
//
// Cost (tools/gxpinfo.py, instructions per pixel): floor written as
// x - frac(x) compiles shorter than floor(x); the fog is the dearest part
// (~13 of a textured program's ~27); the specular 4. Keep this function the
// same in nativeres_textured_f.cg, nativeres_textured_test_f.cg and
// nativeres_textured_read_f.cg.
#define FLOOR(x) ((x) - frac(x))
float4 GeShade(float4 texel, float4 vertexColor, float3 specular, float fog, float4 fogAndScale)
{
#ifdef GE_FILTER
	float4 t = texel; // GeTexel's whole values
#else
	float4 t = FLOOR(texel * 255.0f + 0.5f);
#endif
	float4 p1 = FLOOR(vertexColor * 255.0f + 1.01f); // p + 1
	float4 c = FLOOR(p1 * t * (float4(fogAndScale.aaa, 1.0f) * (1.0f / 256.0f)));
#ifdef NO_SPECULAR
	c.rgb = min(c.rgb, 255.0f);
#else
	c.rgb = min(c.rgb + FLOOR(specular * 255.0f + 0.5f) * fogAndScale.aaa, 255.0f);
#endif
#ifdef NO_FOG
	// No fog: f = 255 leaves every colour 0..255 as it is ((255 c + 255) >> 8 = c).
	return c;
#endif
	float f = min(FLOOR(saturate(fog) * 256.0f + 0.01f), 255.0f);
#ifdef FOG_UNFLOORED
	// The caller floors it with its cut (floor(floor(x) / 8) = floor(x / 8)).
	c.rgb = (f * (c.rgb - fogAndScale.rgb) + (fogAndScale.rgb * 255.0f + 255.0f)) * (1.0f / 256.0f);
#else
	c.rgb = FLOOR((f * (c.rgb - fogAndScale.rgb) + (fogAndScale.rgb * 255.0f + 255.0f)) * (1.0f / 256.0f));
#endif
	return c;
}

// The dither value (-8..7) of the PSP pixel under `position` (WPOS: two of
// ours per PSP pixel), from the GE's 4x4 dither matrix `row0..3` (core
// frame.rs `dither_value`): its row and column picked by one-hot weights.
// GE_FILTER: the GE's filter (nativeres_textured_f.cg's comment; keep GeTexel the same).
#ifdef GE_FILTER
// The GE's bilinear filter of a point-filtered texture, as the GE's whole
// values 0..255 (GeShade and the flat program take them as they are). Point
// samples of 8-bit texels are k / 255 in fp32 (tex2D<float4>; within an ulp:
// within 0.0001 levels). The horizontal lerps on them unrounded: the GE's
// value (A (16 - f) + B f) / 16 is a multiple of 1/16, so + 1/32 floors it to
// the GE's truncation; the vertical lerp on whole values is exact (sums below
// 2^13). Proof over all texel pairs and fractions, also one ulp off: DESIGN
// "sixty-third session" (the old way rounded each texel first and went
// through k / 255 again: 13 instructions more per pixel).
#ifdef GE_WIDE
// GE_WIDE (the "pspwide" twins, DESIGN "sixty-fifth session"; the four point
// samples described above after #else): the texture is
// the texture cache's U16x4 copy (GpuFormat::Wide16: k x 257, read as k / 255)
// with the LINEAR filter, of power-of-two size. The texture unit does the
// horizontal lerps (A (16 - f) + B f) / 16 at 16 bits (within 1/257 level;
// at 8 bits it rounds to whole values, 1 off: tested), each row read at its
// centre (vertical weight 0) and texel centre + f / 16 (exact coordinates:
// the size is a power of two); + 1/32 floors to the GE's truncation as
// below. 2 reads instead of 4 and 10 instructions less. Same pixels as the
// four point samples (device test getexeltest, 0 of 262144 pixels differ).
float4 GeTexel(sampler2D tex, float2 uv, float4 size)
{
	float2 step = 1.0f / size.xy;
	float2 m = FLOOR(uv * (size.xy * 16.0f)) * (1.0f / 16.0f) - size.z * (1.0f / 16.0f);
	float2 fraction = frac(m); // f / 16, exact
	// (cell.x + f.x w, cell.y) with cell = m - fraction, then the texel centres (2026-11-26,
	// DESIGN "seventy-second session"; 1 instruction less than cell + 0.5 per axis). Every
	// value a multiple of 1/16 texel below 2^19 texels and the step a power of two: each step exact
	// in any order the compiler picks, the same coordinates as before.
	float2 at = (m + fraction * float2(size.w - 1.0f, -1.0f)) * step + 0.5f * step;
	float4 top = FLOOR(tex2D<float4>(tex, at) * 255.0f + (1.0f / 32.0f));
	float4 bottom = FLOOR(tex2D<float4>(tex, float2(at.x, at.y + step.y)) * 255.0f + (1.0f / 32.0f));
	return FLOOR(top + (bottom - top) * (fraction.y * size.w));
}
#else
float4 GeTexel(sampler2D tex, float2 uv, float4 size)
{
	float2 step = 1.0f / size.xy; // only lands the reads inside their texels
	float2 p = FLOOR(uv * size.xy * 16.0f) - size.z;
	float2 m = p * (1.0f / 16.0f);
	float2 fraction = frac(m); // f / 16, exact
	float2 at = (m - fraction + 0.5f) * step;
	float2 next = at + step;
	float2 f = fraction * size.w; // 0 for the GE's nearest texel
	float4 a = tex2D<float4>(tex, at);
	float4 b = tex2D<float4>(tex, float2(next.x, at.y));
	float4 c = tex2D<float4>(tex, float2(at.x, next.y));
	float4 d = tex2D<float4>(tex, next);
	float4 top = FLOOR((a + (b - a) * f.x) * 255.0f + (1.0f / 32.0f));
	float4 bottom = FLOOR((c + (d - c) * f.x) * 255.0f + (1.0f / 32.0f));
	return FLOOR(top + (bottom - top) * f.y);
}
#endif // GE_WIDE
#define SAMPLE(tex, uv) GeTexel(tex, uv, uTexSize)
#else
#define SAMPLE(tex, uv) tex2D(tex, uv)
#endif

float DitherValue(float2 position, float4 row0, float4 row1, float4 row2, float4 row3)
{
	float2 psp = floor(position * 0.5f);
	float2 cell = psp - 4.0f * floor(psp * 0.25f);
	const float4 columns = float4(0.0f, 1.0f, 2.0f, 3.0f);
	float4 rowWeights = saturate(1.0f - abs(cell.y - columns));
	float4 columnWeights = saturate(1.0f - abs(cell.x - columns));
	float4 matrixRow = rowWeights.x * row0 + rowWeights.y * row1 + rowWeights.z * row2 + rowWeights.w * row3;
	return dot(matrixRow, columnWeights);
}

#ifdef READ_OFF
// No blending: the result doesn't depend on the target, so no frame read;
// the colour is written in the target's 8-bit format as it is
// (`__regformat`, GXM's output conversion skipped), the alpha kept by
// GXM's colour mask. The same program with GXM's normal alpha blending
// (`ReadWay::Precut`): the source cut, then blended by GXM.
__regformat unsigned char4 main(
#else
__nativecolor __regformat unsigned char4 main(
	__regformat unsigned char4 target : FRAGCOLOR,
#endif
#if !defined(READ_FAST) || defined(READ_DITHER) || (defined(PSP_DEPTH) && !defined(UNTEXTURED))
	float4 vPosition : WPOS,
#endif
#ifndef READ_FAST
	uniform float4 uDither0,
	uniform float4 uDither1,
	uniform float4 uDither2,
	uniform float4 uDither3,
	uniform float4 uSource,
	uniform float4 uDestination,
	uniform float4 uBlend,
	uniform float4 uMinMax,
	uniform float4 uPath,
	uniform float4 uStep,
	uniform float4 uWiden,
	uniform float4 uWidenLow,
	uniform float4 uWrite,
	uniform float4 uStencilTest,
	uniform float4 uStencilWrite,
#endif
#ifdef READ_FIXB
	uniform float4 uStencilTest,
#endif
#ifdef UNTEXTURED
	float4 vColor : COLOR
#else
	float2 vTexcoord : TEXCOORD0,
	float4 vColor : TEXCOORD1,
	float2 vFog : TEXCOORD2,
	float3 vSpecular : TEXCOORD3,
#ifdef PSP_DEPTH
	float2 vDepth : TEXCOORD4,
	out float depth : DEPTH,
#endif
	uniform sampler2D tex,
#if !defined(READ_FAST) || defined(READ_FIXB)
	uniform float4 uBlendFix,
#endif
#if !defined(READ_FAST) || defined(READ_TEST)
	uniform float4 uAlphaTest,
#endif
#ifdef GE_FILTER
	uniform float4 uTexSize,
#endif
	uniform float4 uFogAndScale
#endif
#ifdef READ_DITHER
	, uniform sampler2D uDitherTexture : TEXUNIT1
#endif
	)
#ifdef READ_OFF
	: COLOR
#endif
{
	// c: the colour as whole values 0..255 (textured: the GE's own;
	// untextured: rounded, as GXM writes a colour).
#if !defined(READ_FAST) || defined(READ_FIXB)
	// The stencil test (uStencilTest above).
	float stored = (float)(target.a & (unsigned char)uStencilTest.w);
	float stencilPasses = (stored - uStencilTest.x) * (uStencilTest.y - stored) * uStencilTest.z;
#endif
#ifdef UNTEXTURED
	float4 color = vColor;
	float4 c = FLOOR(saturate(color) * 255.0f + 0.5f);
#ifndef READ_FAST
	if (stencilPasses < 0.0f)
		discard;
#endif
#else
	// Colour, specular and fog came times w (screen-linear, nativeres_3d_v.cg).
	float overW = 1.0f / vFog.y;
	// The PSP depth: see "PSP depth" in nativeres_textured_f.cg.
#ifdef PSP_DEPTH
	float2 depthAt = vDepth * overW;
	float2 toCentre = 1.0f - 2.0f * frac(vPosition.xy * 0.5f);
	float distance = depthAt.x + ddx(depthAt.x) * toCentre.x + ddy(depthAt.x) * toCentre.y;
	depth = 0.5f + floor((depthAt.y > 0.0f ? 65535.0f - distance : distance) + 0.01f) * (0.5f / 65535.0f);
#endif
	// The separate specular colour after texturing, then the doubling (PPSSPP:
	// v = p * t + s, then the colour doubling, clamped), then fog.
	float4 c = GeShade(SAMPLE(tex, vTexcoord), vColor * overW, vSpecular * overW, vFog.x * overW, uFogAndScale);
#if defined(READ_FAST) && defined(READ_TEST)
	// The alpha test on the whole alpha, one-sided: only tests that pass
	// the alphas from lo up (greater, greater or equal: core opaque_source.rs
	// `alpha_test_is_one_sided`; the others take the generic program), for
	// which the two-sided test below is "alpha < lo - 0.5" (y - alpha > 0
	// for every alpha). 3 instructions less (normaltest 57 -> 54, offtest
	// 39 -> 36; 2026-11-19).
	if (c.a < uAlphaTest.x)
		discard;
#elif defined(READ_FIXB)
	if (stencilPasses < 0.0f)
		discard;
#elif !defined(READ_FAST)
	// The alpha test on the whole alpha ANDed with the GE's mask (w; 255
	// for most tests; God of War's bright pass: alpha == 0x20 under mask
	// 0x20, as PPSSPP's `(roundAndScaleTo255i(v.a) & mask) op ref`), as
	// nativeres_textured_test_f.cg (uAlphaTest: x = lo - 0.5, y = hi + 0.5,
	// z = 1 or -1 for NOTEQUAL), and the stencil test: one discard for both.
	float tested = (float)((unsigned char)c.a & (unsigned char)uAlphaTest.w);
	if (min((tested - uAlphaTest.x) * (uAlphaTest.y - tested) * uAlphaTest.z, stencilPasses) < 0.0f)
		discard;
#endif
	float4 color = c * (1.0f / 255.0f);
#ifndef READ_FAST
	float sourceAlpha = saturate(color.a);
	color.rgb *= uBlendFix.x + uBlendFix.y * sourceAlpha;
	color.a = lerp(color.a, uBlendFix.w, uBlendFix.z);
#endif
#endif
#ifdef READ_FAST
	// Blended as the GE does (above) from the whole values, cut to 5 bits
	// per channel and widened back. No branch for opaque sources (t(s, 255)
	// = s, t(d, 0) = 0: the terms give the source anyway): the compiler
	// predicates an `if (c.a != 255)` around the terms, so every pixel paid
	// for them plus the branch (53 -> 47 instructions, normaltest 60 -> 57;
	// MHF's intro, frozen frame: its blended layers 14.2 -> 11.0 ms GPU,
	// the alpha-tested ground and houses 14.7 -> 13.0, though most of their
	// pixels are opaque; 2026-11-18).
#if defined(READ_FIXB)
	// As the generic program: the source premultiplied and rounded (s), its
	// factor ONE (the term is s itself), FIX B's term truncated, added
	// (color = c / 255 above). The term without its floor and the sum without
	// its min (2026-11-26, DESIGN "seventy-third session"): t(d, fixB) =
	// (2d + 1)(2 fixB + 1) / 1024 is never whole before its cut (see the normal
	// blend below), so s + term - 1/2 goes through the conversion to bytes as
	// s + floor(term), saturated at 255. kf = (K, K / 2 - 1/2) with
	// K = (2 fixB + 1) / 512, per draw; every step a multiple of 1/1024 below
	// 2^9: exact in any order. `value` is not whole (as the normal blend's).
	color.rgb *= uBlendFix.x + uBlendFix.y * saturate(color.a);
	float4 s = floor(saturate(color) * 255.0f + 0.5f);
	float4 d = (float4)target;
	float fixB = floor(uBlendFix.w * 255.0f + 0.5f);
	float2 kf = fixB * float2(1.0f / 256.0f, 1.0f / 512.0f) + float2(1.0f / 512.0f, 1.0f / 1024.0f - 0.5f);
	float4 value = (d * kf.x + kf.y) + s;
#elif defined(READ_NORMAL)
	// One floor instead of two (2026-11-26, DESIGN "seventy-first session";
	// 6 instructions less). A term t(v, f) = (2v + 1)(2f + 1) / 1024 has an odd
	// numerator: before its cut it is never whole, at least 1/1024 from a whole
	// number on either side. The conversion to bytes at the end rounds to the
	// nearest (ties to even, saturating; measured on the Vita in steps of
	// 1/1024), so floor(A) + B - 1/2 comes out as floor(A) + floor(B): only
	// the source's term is floored here. With K = (2a + 1) / 512:
	// k = (-K, 1 - K, -K / 2 - 1, -K / 2); c k.x + k.w = -A, and
	// floor(-A) = -floor(A) - 1 (A is never whole), hence the - 1 in k.z;
	// d k.y + k.z = B - 3/2. Every step a multiple of 1/1024 below 2^9: exact
	// however the GPU rounds. `value` is NOT whole: up to 1/2 - 1/1024 off the
	// blend's value, for the conversion (or the dither's clamp, which keeps
	// that) to round. Checked for all byte inputs on the PC and on the Vita's
	// GPU (0 wrong of 16,777,216). 565 targets (since the seventy-third
	// session): their cut floors (value + 1/2) x step, the same rounding.
	float4 k = c.a * float4(-1.0f / 256.0f, -1.0f / 256.0f, -1.0f / 512.0f, -1.0f / 512.0f)
		+ float4(-1.0f / 512.0f, 511.0f / 512.0f, -1025.0f / 1024.0f, -1.0f / 1024.0f);
	float4 d = (float4)target;
	float4 value = (d * k.y + k.z) - floor(c * k.x + k.w);
#elif defined(READ_INVISIBLE)
	// A normal blend of alpha 0 (untextured only: every vertex alpha 0,
	// core frame.rs `ReadWay::Invisible`): t(c, 0) = 0, t(d, 255) = d,
	// so the blend is the target; the colour isn't read at all.
	float4 value = (float4)target;
#elif defined(READ_SUBTRACT)
	// One, one, reverse subtract (core frame.rs `ReadWay::Subtract`): terms
	// with factor 255 are the values themselves, so max(d - c, 0); NFS UR's
	// trail buffer fade. The target's read a hair below its whole value
	// stays so; the 565 cut below rounds it.
	float4 value = max((float4)target - c, 0.0f);
#elif defined(READ_ADD) && !defined(READ_565) && !defined(READ_DITHER)
	// The source's term half a level down, k = (K, K / 2 - 1 / 2) with K as
	// above: the conversion to bytes rounds it to its floor (never below
	// -1/2), and the GPU's saturating 8-bit add (`__add_sat`, one
	// instruction) puts it onto the target: the target is not unpacked, no
	// min (5 instructions less). An alpha of 0 added keeps the target's.
	// Checked as the normal blend.
#define READ_ADD_SAT 1
	float2 k = c.a * float2(1.0f / 256.0f, 1.0f / 512.0f) + float2(1.0f / 512.0f, 1.0f / 1024.0f - 0.5f);
	float4 value = c * k.x + k.y;
#ifdef READ_KEEP_ALPHA
	value.a = 0.0f;
#endif
#elif defined(READ_ADD) && defined(READ_DITHER)
	// Dithered: the same term in floats (the dither's clamp and the
	// conversion's rounding, or the 565 cut's floor((value + 1/2) x step),
	// after it: `value` not whole, as the normal blend's).
	float2 k = c.a * float2(1.0f / 256.0f, 1.0f / 512.0f) + float2(1.0f / 512.0f, 1.0f / 1024.0f - 0.5f);
	float4 d = (float4)target;
	float4 value = min((c * k.x + k.y) + d, 255.0f);
#elif defined(READ_ADD)
	// 565 targets, undithered (2026-11-26, DESIGN "seventy-third session"):
	// the same term in floats and no min: the cut floors (value + 1/2) x step,
	// and a step past the last one (h above 31, green above 63) widens past
	// 255, where the conversion to bytes saturates; the alpha likewise.
	float2 k = c.a * float2(1.0f / 256.0f, 1.0f / 512.0f) + float2(1.0f / 512.0f, 1.0f / 1024.0f - 0.5f);
	float4 d = (float4)target;
	float4 value = (c * k.x + k.y) + d;
#else
	float4 value = c;
#endif
#ifdef READ_DITHER
	// The dither after the blend, clamped (alpha not dithered).
	float dither = FLOOR(tex2D(uDitherTexture, vPosition.xy * (1.0f / 16.0f)).x * 255.0f + 0.5f) - 8.0f;
	value.rgb = clamp(value.rgb + dither, 0.0f, 255.0f);
#endif
#ifdef READ_WIDE
	// An 8-bit target: no cut; the cast rounds to the nearest (the blends
	// above leave it their last floor).
#ifdef READ_ADD_SAT
	unsigned char4 cut = __add_sat(target, (unsigned char4)value);
#else
	unsigned char4 cut = (unsigned char4)value;
#ifdef READ_KEEP_ALPHA
	cut.a = target.a;
#endif
#endif
#elif defined(READ_OFF)
	// The cut in floats (2 instructions less than the bit operations
	// below): 5 bits widened = 8 h + (h >> 2) with h = v >> 3, and
	// h x 8.25 - 0.375 lies 0.125 .. 0.375 off that whole number; the cast
	// to unsigned char rounds to the nearest (measured on the Vita,
	// 2026-11-18). The alpha as it is: GXM's blending uses it when the
	// program draws a normal alpha blend (`ReadWay::Precut`).
	// (value's rgb comes unfloored here: FOG_UNFLOORED, floored by h.)
#ifdef READ_565
	// Green in 6 bits: widened = 4 g + (g >> 4) with g = v >> 2, and
	// g x 4.0625 - 0.46875 lies within 0.47 of it (core frame.rs
	// `the_fast_6_bit_cut_is_the_ges_cut`); per channel in one go.
	float4 h = FLOOR(value * float4(0.125f, 0.25f, 0.125f, 0.125f));
	unsigned char4 cut = (unsigned char4)(h * float4(8.25f, 4.0625f, 8.25f, 8.25f) - float4(0.375f, 0.46875f, 0.375f, 0.375f));
#else
	float4 h = FLOOR(value * 0.125f);
	unsigned char4 cut = (unsigned char4)(h * 8.25f - 0.375f);
#endif
	cut.a = (unsigned char)value.a;
#else
	// 5 bits widened = v & 0xF8 | v >> 5 (core frame.rs `cut_to_5_bits`,
	// the same as `quantize_like_the_ge`); value is whole, the cast exact.
#ifdef READ_565
	// 565: the float cut as READ_OFF's (green 6 bits). value is whole in
	// theory, but the target's pixel arrives a hair below its whole value
	// (12 read as 11.99..: the invisible and add ways then floored one step
	// too low, NFS UR's title, 2026-11-21): floor((v + 0.5) x step), the
	// same for whole values and safe for errors up to +-0.4; the normal and
	// add blends rely on it (their value is up to 1/2 - 1/1024 off). The bit
	// operations of the 5551 programs round in their cast first. The alpha
	// (565 has none) written uncut, as the generic program writes it.
	float4 h = FLOOR(value * float4(0.125f, 0.25f, 0.125f, 0.125f) + float4(0.0625f, 0.125f, 0.0625f, 0.0625f));
	unsigned char4 cut = (unsigned char4)(h * float4(8.25f, 4.0625f, 8.25f, 8.25f) - float4(0.375f, 0.46875f, 0.375f, 0.375f));
	cut.a = (unsigned char)value.a;
#else
#ifdef READ_ADD_SAT
	unsigned char4 v = __add_sat(target, (unsigned char4)value);
#else
	unsigned char4 v = (unsigned char4)value;
#endif
	unsigned char4 cut = (v & 0xF8) | (v >> 5);
#endif
#ifdef READ_KEEP_ALPHA
	cut.a = target.a;
#endif
#endif
	return cut;
#else
	// The colour in 8 bits (rounded, as GXM writes a colour) and the
	// target's pixel, both 0..255.
	float4 s = floor(saturate(color) * 255.0f + 0.5f);
	float4 d = (float4)target;
	if (uPath.z > 0.5f)
		return (unsigned char4)s; // measuring only: no blend, no cut

	// The GE's blend (above).
	float4 value;
	if (uPath.x < 0.5f) {
		value = floor((s * 2.0f + 1.0f) * ((s.a * 2.0f + 1.0f) * (1.0f / 1024.0f)))
			+ floor((d * 2.0f + 1.0f) * ((511.0f - s.a * 2.0f) * (1.0f / 1024.0f)));
	} else if (uPath.x < 1.5f) {
		value = min(floor((s * 2.0f + 1.0f) * ((s.a * 2.0f + 1.0f) * (1.0f / 1024.0f))) + d, 255.0f);
	} else if (uPath.x < 2.5f) {
		value = s;
	} else {
		// The factors as 0..255 (exact: whole multiples of 1/255).
		float4 sn = s * (1.0f / 255.0f);
		float4 dn = d * (1.0f / 255.0f);
		float4 sourceFactor = floor((uBlend.x + uSource.x * sn + uSource.y * sn.aaaa + uSource.z * dn + uSource.w * dn.aaaa) * 255.0f + 0.5f);
		float4 destinationFactor = floor((uBlend.y + uDestination.x * sn + uDestination.y * sn.aaaa + uDestination.z * dn + uDestination.w * dn.aaaa) * 255.0f + 0.5f);
		float4 sourceTerm = floor((s * 2.0f + 1.0f) * (sourceFactor * 2.0f + 1.0f) * (1.0f / 1024.0f));
		float4 destinationTerm = floor((d * 2.0f + 1.0f) * (destinationFactor * 2.0f + 1.0f) * (1.0f / 1024.0f));
		value = clamp(uBlend.z * sourceTerm + uBlend.w * destinationTerm, 0.0f, 255.0f);
		if (uMinMax.x > 0.5f)
			value = uMinMax.y > 0.5f ? max(s, d) : min(s, d);
	}

	// The dither value of this PSP pixel (alpha not dithered).
	if (uPath.y > 0.5f) {
		float dither = DitherValue(vPosition.xy, uDither0, uDither1, uDither2, uDither3);
		value = clamp(value + float4(dither, dither, dither, 0.0f), 0.0f, 255.0f);
	}

	// Cut to the target's bits, widened back to 8.
	float4 cut = floor(value * uStep);
	float4 written = cut * uWiden + floor(cut * uWidenLow);
	// The stencil value as the alpha (uStencilWrite above).
	written.a = lerp(written.a, uStencilWrite.x, uStencilWrite.y);
	return (unsigned char4)lerp(d, written, uWrite);
#endif
}
