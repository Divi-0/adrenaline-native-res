#define PSP_DEPTH 1
// NativeRes: vertex program for textured PSP draws.
//
// aPosition: x, y in vita2d's 960x544 units, z, and w. The position is
// multiplied by w after the projection, so the GPU divides by it again:
// the picture is unchanged, but texture coordinates are then interpolated
// with perspective (w = 1 for 2D draws). Colour and fog leave times w, with
// w in vFog.y, so the fragment program gets them linear on the screen, as
// the PSP shades (see nativeres_3d_v.cg).
// aColor: per-vertex colour (PSP vertex colour or material colour, with the
// texture function applied), RGBA bytes read as 0..1.
// aFog: PSP fog factor, 1 = no fog, 0 = fog colour (see nativeres_textured_f.cg).
//
// Compiled on the Vita with the shader compiler app (README.md "Shaders").

void main(
	float4 aPosition,
	float2 aTexcoord,
	float4 aColor,
	float aFog,
	uniform float4x4 wvp,
#ifdef PSP_DEPTH
	uniform float uDepthFar,
#endif
	out float4 vPosition : POSITION,
	out float2 vTexcoord : TEXCOORD0,
	out float4 vColor : TEXCOORD1,
	out float2 vFog : TEXCOORD2,
	out float3 vSpecular : TEXCOORD3
#ifdef PSP_DEPTH
	, out float2 vDepth : TEXCOORD4
#endif
	)
{
	// The separate specular colour (LIGHTMODE 1), added after texturing by
	// the fragment program; 0 unless lit with it.
	vSpecular = float3(0.0f, 0.0f, 0.0f);
	vPosition = mul(float4(aPosition.xyz, 1.0f), wvp) * aPosition.w;
	vTexcoord = aTexcoord;
	// Times w, see nativeres_3d_v.cg (screen-linear colour and fog).
	vColor = aColor * aPosition.w;
	vFog = float2(aFog, 1.0f) * aPosition.w;
	// The PSP depth (nativeres_3d_v.cg vDepth); uDepthFar: 1 or -1 (draw.rs by the depth test).
#ifdef PSP_DEPTH
	float pspDepth = floor(saturate(aPosition.z) * 65535.0f);
	vDepth = float2(uDepthFar > 0.0f ? 65535.0f - pspDepth : pspDepth, uDepthFar) * aPosition.w;
#endif
}
