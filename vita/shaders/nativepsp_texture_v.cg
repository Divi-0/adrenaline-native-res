// NativePSP: vertex program for full-screen quads (render-target copies,
// presenting our picture, the GPU unswizzle) and textured draws without our
// textured program (basic_programs.rs; vita2d's texture program until
// stage 2).
//
// aPosition: x, y in 960x544 pixels, z (the vertex's w, 1, is not read);
// aTexcoord: texture coordinates. wvp: the projection.
//
// Compiled on the Vita: python tools/vita.py shaders.

void main(
	float3 aPosition,
	float2 aTexcoord,
	uniform float4x4 wvp,
	out float4 vPosition : POSITION,
	out float2 vTexcoord : TEXCOORD0)
{
	vPosition = mul(float4(aPosition, 1.0f), wvp);
	vTexcoord = aTexcoord;
}
