#define PSP_DEPTH 1
#define GE_LIGHT 1
// NativeRes: vertex program for textured 3D draws whose vertices are still in
// model space (NativeResDraw.transform, frame.rs GpuTransform): it does what
// the capture's CPU path does per vertex (RowTransform::apply), then what
// nativeres_textured_v.cg does. Same outputs, so the same fragment programs.
//
// aPosition: model-space position.
// aNormal: GPU-lit draws only: the vertex's normal (lighting.rs pack_normal,
//   four signed bytes in the vertex's w); other draws' w is not a normal.
// aTexcoord, aColor: as for nativeres_textured_v.cg (already final), except
//   for GPU-lit draws: aColor is the raw vertex colour, lit here.
// uRows: projection x view x world (bone, position scale folded in), row by row.
// uFogRow: fog factor = uFogRow . position; (0, 0, 0, 1) without fog.
// uViewport: origin x, y and scale x, y, in PSP pixels.
// uDepth: x = depth centre, y = depth scale (PSP depth / 65535).
// vDepth: the PSP depth for the fragment programs' depth writes (nativeres_textured_f.cg "PSP
//   depth"): the vertex's depth floored to a whole 16-bit unit, as the GE does, sent as its
//   distance from the far end (x; far = 65535 with a positive depth scale, 0 otherwise: after
//   interpolation varyings keep only ~16 significant bits, measured 2026-11-23, and depths crowd
//   at the far end) and the far end's side (y: 1 or -1), both times w (screen-linear).
// wvp: our NativeMatrix (PSP pixels and depth to the Vita's clip space).
// uUvScale: multiplies the texture coordinates (1, 1 but for textures from
// our render targets; nativeres_textured_v.cg's draws get it on the CPU).
// uNormalRows: rows 0..2: the matrix taking aNormal to world space (world x
//   bone, negated for REVERSENORMAL); row 3 x: > 0 = the draw is GPU-lit.
// uLights: GPU-lit draws: frame.rs GpuLights as 22 float4:
//   0..3 towards each light, 4..7 the specular half vectors,
//   8..11 diffuse colours (a: powered diffuse), 12..15 specular colours
//   (a: the light has specular), 16 ambient light (+ the lights' ambient;
//   a: ambient alpha), 17 emissive (a: specular coefficient), 18 material
//   ambient, 19 material diffuse (a: result opaque), 20 material specular
//   (a: separate specular, LIGHTMODE 1: the specular part goes to vSpecular),
//   21 x, y, z: ambient, diffuse, specular from the vertex colour.
//   The lighting is PPSSPP's hardware vertex shader's for directional
//   lights (VertexShaderGenerator.cpp), its CPU twin GpuLights::color.
//
// Only vertices in front of the PSP's near plane come here (the capture
// clips the others), so clip.w > 0.
//
// Screen-linear colour and fog (the PSP's Gouraud shading and fog are not
// perspective corrected, ppsspp-ref GPU/Software/Rasterizer.cpp "Color
// interpolation is not perspective corrected on the PSP"): the GPU
// interpolates every varying with perspective, so colour, specular and fog
// leave here times w, with w itself in vFog.y; the fragment program divides
// by the interpolated w, which leaves the screen-linear value.
//
// Compiled on the Vita with the shader compiler app (README.md "Shaders").

// The GE's pow for lighting, as PPSSPP's shader without bit operations:
// 1 for e <= 0, else 0 for x <= 0, else a true pow ("close enough"; the GE
// interpolates between powers of two, lighting.rs psp_pow).
float PspPow(float x, float e)
{
	if (e <= 0.0f)
		return 1.0f;
	return x > 0.0f ? exp2(e * log2(x)) : 0.0f;
}

#ifdef GE_LIGHT
// GE_LIGHT (God of War's program set, psp_depth_twins.txt; core
// lighting.rs GpuLights::ge_color is its CPU twin): the lighting in the
// GE's integer arithmetic (ppsspp-ref GPU/Software/Lighting.cpp, GEMath.h
// GELightColorProduct / GELightColorScale), colours as 0..255 integers:
// light x material ((2l + 1)(2m + 1)) >> 10, a factor f (N.L, its power,
// the attenuation) as s = floor(256 f) in 0..256, ((2x + 1)(2s + 1)) >> 10,
// the terms summed, clamped at 255. Exact in fp32 (products below 2^18,
// the / 1024 a power of two). The float lighting below was ~1 level
// brighter per light.
float3 GeProduct(float3 l, float3 m)
{
	return floor((2.0f * l + 1.0f) * (2.0f * m + 1.0f) * (1.0f / 1024.0f));
}

float3 GeScale(float3 x, float f)
{
	float s = clamp(floor(256.0f * f), 0.0f, 256.0f);
	return floor((2.0f * x + 1.0f) * (2.0f * s + 1.0f) * (1.0f / 1024.0f));
}

float3 Ge8(float3 c)
{
	return floor(c * 255.0f + 0.5f);
}
#endif

void main(
	float3 aPosition,
	float4 aNormal,
	float2 aTexcoord,
	float4 aColor,
	uniform float4x4 wvp,
	uniform float4 uRows[4],
	uniform float4 uFogRow,
	uniform float4 uViewport,
	uniform float4 uDepth,
	uniform float2 uUvScale,
	uniform float4 uNormalRows[4],
	uniform float4 uLights[22],
	out float4 vPosition : POSITION,
	out float2 vTexcoord : TEXCOORD0,
	out float4 vColor : TEXCOORD1,
	out float2 vFog : TEXCOORD2,
	out float3 vSpecular : TEXCOORD3
#ifdef PSP_DEPTH
	, out float2 vDepth : TEXCOORD4
#endif
	)
{
	// The separate specular colour (LIGHTMODE 1), added after texturing by
	// the fragment program; 0 unless lit with it.
	vSpecular = float3(0.0f, 0.0f, 0.0f);
	float4 p = float4(aPosition, 1.0f);
	float4 clip = float4(dot(uRows[0], p), dot(uRows[1], p), dot(uRows[2], p), dot(uRows[3], p));
	float overW = 1.0f / clip.w;
	float3 screen = float3(uViewport.xy + uViewport.zw * clip.xy * overW, saturate(uDepth.x + uDepth.y * clip.z * overW));
	// As nativeres_textured_v.cg: times w, so the GPU interpolates with perspective.
	vPosition = mul(float4(screen, 1.0f), wvp) * clip.w;
	vTexcoord = aTexcoord * uUvScale;
	vFog = float2(dot(uFogRow, p), 1.0f) * clip.w;
#ifdef PSP_DEPTH
	float farSide = uDepth.y >= 0.0f ? 1.0f : -1.0f;
	float pspDepth = floor(screen.z * 65535.0f);
	vDepth = float2(farSide > 0.0f ? 65535.0f - pspDepth : pspDepth, farSide) * clip.w;
#endif

	float4 color = aColor;
	if (uNormalRows[3].x > 0.5f) {
		float3 n = float3(dot(uNormalRows[0].xyz, aNormal.xyz), dot(uNormalRows[1].xyz, aNormal.xyz),
		                  dot(uNormalRows[2].xyz, aNormal.xyz));
		float length2 = dot(n, n);
		n = length2 > 0.0f ? n * rsqrt(length2) : float3(0.0f, 0.0f, 1.0f);
		float4 fromVertex = uLights[21];
		float4 ambientColor = lerp(uLights[18], aColor, fromVertex.x);
		float3 diffuseColor = lerp(uLights[19].rgb, aColor.rgb, fromVertex.y);
		float3 specularColor = lerp(uLights[20].rgb, aColor.rgb, fromVertex.z);
		float coefficient = uLights[17].a;
#ifdef GE_LIGHT
		float3 ambient8 = Ge8(ambientColor.rgb);
		float3 diffuse8 = Ge8(diffuseColor);
		float3 specular8 = Ge8(specularColor);
		float3 sum = Ge8(uLights[17].rgb) + GeProduct(Ge8(uLights[16].rgb), ambient8);
		float3 specularSum = float3(0.0f, 0.0f, 0.0f);
		for (int i = 0; i < 4; i++) {
			float lightDot = dot(uLights[i].xyz, n);
			if (uLights[8 + i].a > 0.5f)
				lightDot = PspPow(lightDot, coefficient);
			sum += GeScale(GeProduct(Ge8(uLights[8 + i].rgb), diffuse8), lightDot);
			if (uLights[12 + i].a > 0.5f && lightDot >= 0.0f)
				specularSum += GeScale(GeProduct(Ge8(uLights[12 + i].rgb), specular8), PspPow(dot(uLights[4 + i].xyz, n), coefficient));
		}
		if (uLights[20].a > 0.5f) {
			// Separate specular: after texturing (vSpecular).
			vSpecular = min(specularSum, 255.0f) * (1.0f / 255.0f) * clip.w;
		} else {
			sum += specularSum;
		}
		color.rgb = min(sum, 255.0f) * (1.0f / 255.0f);
		float ambientAlpha = GeProduct(Ge8(uLights[16].aaa), Ge8(ambientColor.aaa)).x;
		color.a = uLights[19].a > 0.5f ? 1.0f : ambientAlpha * (1.0f / 255.0f);
#else
		float3 diffuse = float3(0.0f, 0.0f, 0.0f);
		float3 specular = float3(0.0f, 0.0f, 0.0f);
		for (int i = 0; i < 4; i++) {
			float lightDot = dot(uLights[i].xyz, n);
			if (uLights[8 + i].a > 0.5f)
				lightDot = PspPow(lightDot, coefficient);
			diffuse += uLights[8 + i].rgb * max(lightDot, 0.0f);
			if (uLights[12 + i].a > 0.5f && lightDot >= 0.0f)
				specular += uLights[12 + i].rgb * PspPow(dot(uLights[4 + i].xyz, n), coefficient);
		}
		float3 specularPart = specular * specularColor;
		if (uLights[20].a > 0.5f) {
			// Separate specular: after texturing (vSpecular).
			vSpecular = saturate(specularPart) * clip.w;
			specularPart = float3(0.0f, 0.0f, 0.0f);
		}
		color.rgb = saturate(uLights[17].rgb + uLights[16].rgb * ambientColor.rgb + diffuse * diffuseColor + specularPart);
		color.a = uLights[19].a > 0.5f ? 1.0f : saturate(uLights[16].a * ambientColor.a);
#endif
	}
	vColor = color * clip.w;
}
